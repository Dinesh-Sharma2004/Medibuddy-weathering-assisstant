# Template only — do NOT put real keys here and do NOT commit the real file.
# The real .streamlit/secrets.toml is gitignored.
#
# On Streamlit Community Cloud: open your app -> Manage app -> Settings -> Secrets,
# and paste the lines below (with real values). Streamlit also exposes these as
# environment variables, which is exactly what app.py / llm.py read via os.environ.
#
# For LOCAL runs, this project uses a .env file instead (see .env.example); you do not
# need a local secrets.toml.

OPENAI_API_KEY = "your-key-here"
OPENAI_MODEL = "your-model-name-here"
OPENAI_BASE_URL = "https://api.groq.com/openai/v1"

# Optional LLM tuning (defaults applied if omitted):
# OPENAI_MAX_TOKENS = "4096"
# OPENAI_MAX_RETRIES = "3"
# OPENAI_TIMEOUT_S = "30"
